{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Punto de Venta Cauloti",
  "version": "1.0.0",
  "identifier": "mx.cauloti.pos",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Punto de Venta Cauloti",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/cauloti_server"
    ]
  }
}

